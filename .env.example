# Ortam değişkeni şablonu. Kopyalayın: Copy-Item .env.example .env  (.env git'e eklenmez)
# Gizli anahtarlar yalnızca .env / ortamda tutulur, YAML'a yazılmaz.
# .env'deki değerler ortamda zaten tanımlı değişkenleri ezmez; boş değerler ("ANAHTAR=") yok sayılır.

# Servis adresleri (varsayılanlar yerel kurulum içindir).
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434

# Opsiyonel: yalnızca llm.provider veya eval.judge.provider "anthropic" seçilirse gerekir.
# Varsayılan yapılandırma yereldir ve bu anahtarı kullanmaz.
# ANTHROPIC_API_KEY=sk-ant-...

# Opsiyonel: OpenAI uyumlu API (OpenRouter, Groq, Hugging Face Inference Providers…).
# Yalnızca configs/default.yaml'da llm.provider: openai_compat seçilirse kullanılır; model adı
# llm.model alanına yazılır. Sorular ve kaynak metinler bu servise gider; ücretlendirilebilir.
# Adres verilmezse yerel Ollama'nın /v1 uç noktası kullanılır (Docker'da http://ollama:11434/v1).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=...

# Opsiyonel: HuggingFace erişim token'ı (huggingface.co > Settings > Access Tokens, "read").
# Yalnız erişimi kısıtlı (gated) bir modeli indirmek için gerekir; varsayılan modeller
# (google/embeddinggemma-2, BAAI/bge-reranker-v2-m3) şu an anonim iner. Modelin sayfasında
# lisansı token'ın sahibi olan hesapla kabul etmek gerekir. Docker'da compose bu değeri
# container'a geçirir; boşsa geçirilmiş sayılmaz. Token'ı yalnız .env'de tutun.
# HF_TOKEN=hf_...

# Opsiyonel: HuggingFace model önbelleği klasörü. Tanımlanmazsa kütüphanenin varsayılanı
# (~/.cache/huggingface) kullanılır. Boş bırakılmış bir HF_HOME= satırı yazmayın.
# HF_HOME=D:\hf-cache

# ------------------------------------------------------------------ Cihaz ve CPU politikası
# Hem yerel kurulumda hem Docker'da geçerlidir (ayrıntı: src/tubitak_rag/device_policy.py).
# auto: GPU varsa GPU, yoksa CPU · cpu: hep CPU · cuda: GPU yoksa hata.
# TUBITAK_RAG_DEVICE=auto
# Reranker CPU'da çalışırken yeniden sıralanacak en fazla aday (~0,7 s/aday; 6 ≈ 4,7 s).
# 0 = CPU'da reranker kapalı, none = sınır yok. GPU'da etkisizdir.
# RERANKER_CPU_CANDIDATES=6
# LLM cevabı için bekleme süresi (s). CPU'da Qwen3 4B yavaştır; Docker varsayılanı 300.
# LLM_TIMEOUT_S=120

# ------------------------------------------------------------------ Docker (docker compose)
# Bu değerleri docker compose okur (yukarıdaki QDRANT_URL/OLLAMA_URL container içinde
# compose tarafından qdrant:6333 / ollama:11434 olarak ayarlanır; burada değiştirmeyin).
# Web arayüzünün host portu. 8000 doluysa (ör. yerel `rag serve`) başka bir port seçin.
# APP_PORT=8000
# 127.0.0.1 = yalnız bu bilgisayar; ağdaki başka cihazlardan erişim için 0.0.0.0.
# APP_BIND=127.0.0.1
# Kullanılacak yapılandırma (imaj içindeki yol).
# APP_CONFIG=configs/default.yaml
# İlk açılışta koleksiyon boşsa otomatik rag fetch + rag ingest (0 = kapalı).
# TUBITAK_RAG_AUTO_INGEST=1
# İlk açılışta HF modellerini (embedder, reranker) önceden indir (0 = ilk soruda iner).
# TUBITAK_RAG_WARMUP=1
# Ollama imajı ve modelin bellekte kalma süresi.
# OLLAMA_IMAGE=ollama/ollama:latest
# OLLAMA_KEEP_ALIVE=10m
# Hazır indeks paketi (rag export-index çıktısı). init önce bu klasörde manifest.json arar
# (host yolu; container'da /app/release, salt-okunur), yoksa INDEX_BUNDLE_URL'den indirir.
# Paketle ilk açılışta belge indirme + ayrıştırma + embedding atlanır (ingest yok).
# INDEX_BUNDLE_DIR=./release
# Paketin adresi: manifest.json'un bulunduğu klasör ya da doğrudan manifest.json. Varsayılan
# projenin Hugging Face veri seti (243,7 MB); kendi kopyanız için değiştirin.
# INDEX_BUNDLE_URL=https://huggingface.co/datasets/lolalol57/tubitak-mevzuat-rag-index/resolve/main/
# Paketi hiç kullanma (0) / paketten sonra kaynak belgeleri de indir (1; önizleme ve elle
# ingest için, ~160 MB).
# TUBITAK_RAG_USE_BUNDLE=1
# TUBITAK_RAG_BUNDLE_FETCH=0
# GPU eki (docker-compose.gpu.yml) için CUDA'lı PyTorch paket dizini.
# TORCH_INDEX_URL_GPU=https://download.pytorch.org/whl/cu128

# ------------------------------------------------------------------ REST API yönetimi
# POST /api/ingest ve POST /api/runs yalnız bu anahtar tanımlıysa ve istek
# "Authorization: Bearer <anahtar>" taşıyorsa çalışır; tanımlı değilse kapalıdır (403).
# Soru sorma (/api/ask) her durumda açıktır.
# TUBITAK_RAG_ADMIN_TOKEN=
